# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# --- Required ---

# Vercel Blob storage token. Vercel sets this for you when you add Blob storage (Private access) to the project.
# Newer stores set BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY instead and leave this blank. Muesli works with both.
# For local runs, copy it from your Vercel project's environment variables.
BLOB_READ_WRITE_TOKEN=

# Secret used to sign login sessions. Generate one with: npx auth secret
AUTH_SECRET=

# The email and password you will sign in with. Choose your own.
AUTH_EMAIL=
AUTH_PASSWORD=

# --- Optional ---

# Your OpenAI API key. It transcribes recordings and writes the notes.
# Get one at https://platform.openai.com/api-keys
# Leave it blank and the app asks each person for their own key, kept in their browser.
OPENAI_API_KEY=

# The OpenAI model that writes the notes. Leave blank to use the default set in lib/ai.ts.
OPENAI_NOTES_MODEL=

# --- Optional: Google sign-in and calendar (set all three or none) ---

# A Google OAuth client from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A Postgres connection string. Google sign-in stores its accounts here.
DATABASE_URL=
